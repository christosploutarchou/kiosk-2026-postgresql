<Window x:Class="CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Διαχείριση Κατηγοριών" Height="800" Width="1024" ResizeMode="NoResize" Background="#FFD4D0C8">

    <Canvas>
        <!-- ListBox -->
        <ListBox Canvas.Left="640" Canvas.Top="8" Width="353" Height="616"
                 ItemsSource="{Binding Categories}" 
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontFamily="Segoe UI Semibold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - VAT: {1}%">
                                    <Binding Path="Description"/>
                                    <Binding Path="Vat"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Labels and TextBoxes -->
        <Label Content="Περιγραφή" FontSize="27" Canvas.Left="8" Canvas.Top="20" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxDescription" Text="{Binding SelectedCategory.Description, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="280" Canvas.Top="20" Width="340" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <Label Content="Φ.Π.Α (%)" FontSize="27" Canvas.Left="8" Canvas.Top="80" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxVAT" Text="{Binding SelectedCategory.Vat, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="280" Canvas.Top="80" Width="340" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <!-- Buttons -->
        <Button Content="Αποθήκευση" Width="184" Height="60" Canvas.Left="466" Canvas.Top="465" Click="SaveButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="Νέα" Width="80" Height="60" Canvas.Left="668" Canvas.Top="465" Click="NewButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="Έξοδος" Width="134" Height="60" Canvas.Left="769" Canvas.Top="465" Click="ExitButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Canvas>
</Window>
