<Window x:Name="AdminWindow" x:Class="AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kiosk_2026"
        mc:Ignorable="d"
        Title="Admin Window" Height="722" Width="1022" ResizeMode="NoResize" Background="#FFD4D0C8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="793*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Χρήστης:" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
        <TextBox x:Name="txtBoxUser" HorizontalAlignment="Left" Margin="139,14,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" FontSize="18" Grid.Column="1" IsReadOnly="True" Background="#FFFFE1C0"/>
        <Label Content="v0.01" HorizontalAlignment="Left" Margin="739,10,0,0" VerticalAlignment="Top" FontSize="9" FontFamily="Segoe UI Semibold" FontWeight="Bold" Grid.Column="1"/>
        <Button x:Name="btnPOS" Content="POS" HorizontalAlignment="Left" Margin="8,52,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnUsers" HorizontalAlignment="Left" Margin="194,52,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27" Background="#FFD4D0C8">
            <Grid>
                <Image Source="/users.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Text="Χρήστες" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <Button x:Name="btnProducts" Content="Products" HorizontalAlignment="Left" Margin="8,164,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnInvoices" Content="Invoices" HorizontalAlignment="Left" Margin="194,165,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnSuppliers"  HorizontalAlignment="Left" Margin="380,52,0,0" VerticalAlignment="Top" Height="102" Width="184" Grid.Column="1" FontSize="27" Background="#FFD4D0C8">
            <Grid>
                <Image Source="/suppliers.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Text="Διαχείριση Προμηθευτών" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <Button x:Name="btnReports" Content="Reports" HorizontalAlignment="Left" Margin="380,165,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnCategories" HorizontalAlignment="Left" Margin="635,52,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27" Focusable="False" Background="#FFD4D0C8">
            <Grid>
                <Image Source="/categories.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Text="Διαχείριση Κατηγοριών" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

        <Button x:Name="btnReceipts" Content="Receipts" HorizontalAlignment="Left" Margin="567,165,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnBackup" Content="POS Management" HorizontalAlignment="Left" Margin="811,52,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Button x:Name="btnLottery"  HorizontalAlignment="Left" Margin="753,165,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27">
            <Grid>
                <Image Source="/lottery.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Text="Λαχεία" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

        <Button x:Name="btnExit" HorizontalAlignment="Left" Margin="753,283,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27" Background="#FFD4D0C8" >
            <Grid>
                <Image Source="/exit.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Έξοδος" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <Button x:Name="btnUpdate" HorizontalAlignment="Left" Margin="194,283,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27" Background="#FFD4D0C8" >
            <Grid>
                <Image Source="/save.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Αποθήκευση" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

        <Button x:Name="btnOffers" Content="Offers" HorizontalAlignment="Left" Margin="567,283,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27"/>
        <Label Content="Αρχικό ποσό ταμείου" HorizontalAlignment="Left" Margin="5,270,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe UI Semibold" Grid.Column="1" />
        <TextBox x:Name="txtBoxInitialFiscalAmt" HorizontalAlignment="Left" Margin="28,305,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" FontSize="18" Grid.Column="1" Background="#FFFFE1C0"/>
        <DataGrid x:Name="dgvMessages" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2" Margin="6,389,519,7" Background="#FFFFE1C0"/>
        <DataGrid x:Name="dgvExpiry" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="509,389,13,167" Grid.Column="1" Background="#FFFFE1C0"/>
        <DataGrid x:Name="dgvSuppliers" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="509,549,13,7" Grid.Column="1" Background="#FFFFE1C0"/>

        <Button x:Name="btnMessages"  HorizontalAlignment="Left" Margin="387,288,0,0" VerticalAlignment="Top" Height="102" Width="170" Grid.Column="1" FontSize="27" Background="#FFD4D0C8">
            <Grid>
                <Image Source="/messages.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Ανανέωση μηνυμάτων" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

    </Grid>
</Window>
