<Window x:Name="PosWindow" x:Class="PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kiosk_2026"
        mc:Ignorable="d"
        Title="Admin Window" Height="722" Width="1022" ResizeMode="NoResize" Background="#FFD4D0C8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="793*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Barcode" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
        <TextBox x:Name="txtBoxBarcode" HorizontalAlignment="Left" Margin="139,14,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" FontSize="18" Grid.Column="1" Background="#FFFFE1C0"/>
        <Button x:Name="btnClearBarcode" HorizontalAlignment="Left" Margin="274,14,0,0" VerticalAlignment="Top" Height="30" Width="40" Grid.Column="1" FontSize="27" Background="#FFD4D0C8"/>

        <Button x:Name="btnReceipts" HorizontalAlignment="Left" Margin="721,17,0,0" VerticalAlignment="Top" Height="60" Width="140" Grid.Column="1" FontSize="27" Background="#FFD4D0C8" >
            <Grid>
                <Image Source="/receipts.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Αποδείξεις" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <Button x:Name="btnExit" HorizontalAlignment="Left" Margin="867,17,0,0" VerticalAlignment="Top" Height="60" Width="140" Grid.Column="1" FontSize="27" Background="#FFD4D0C8" >
            <Grid>
                <Image Source="/exit.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Έξοδος" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <DataGrid x:Name="dgvMessages" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2" Margin="6,61,304,412" Background="#FFFFE1C0"/>
        <Label Content="Ποσότητα" HorizontalAlignment="Left" Margin="349,10,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
        <TextBox x:Name="txtBoxQuantity" HorizontalAlignment="Left" Margin="450,14,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" FontSize="18" Grid.Column="1" Background="#FFFFE1C0"/>
