<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>kiosk_2026</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="categories.png" />
    <None Remove="exit.png" />
    <None Remove="loginButton.png" />
    <None Remove="logout.png" />
    <None Remove="messages.png" />
    <None Remove="save.png" />
    <None Remove="suppliers.jpg" />
    <None Remove="suppliers.png" />
    <None Remove="users.png" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="categories.png" />
    <Resource Include="exit.png" />
    <Resource Include="loginButton.png" />
    <Resource Include="logout.png" />
    <Resource Include="messages.png" />
    <Resource Include="save.png" />
    <Resource Include="suppliers.jpg" />
    <Resource Include="suppliers.png" />
    <Resource Include="users.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SuppliersWindow.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UsersWindow.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
