<Window x:Class="UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Διαχείριση Χρηστών" Height="800" Width="1024" ResizeMode="NoResize" Background="#FFD4D0C8">

    <Canvas>
        <!-- ListBox -->
        <ListBox Canvas.Left="640" Canvas.Top="8" Width="353" Height="616"
                 ItemsSource="{Binding Users}" 
                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontFamily="Segoe UI Semibold" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - {1}">
                                    <Binding Path="Username"/>
                                    <Binding Path="Fullname"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Labels and TextBoxes -->
        <Label Content="Όνομα Χρήστη" FontSize="27" Canvas.Left="8" Canvas.Top="20" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxUsername" Text="{Binding SelectedUser.Username, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="280" Canvas.Top="20" Width="340" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.083"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>

        <Label Content="Ονοματεπώνυμο" FontSize="27" Canvas.Left="8" Canvas.Top="80" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxFullname" Text="{Binding SelectedUser.Fullname, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="280" Canvas.Top="80" Width="340" HorizontalAlignment="Left" VerticalAlignment="Center" />


        <Label Content="Τηλέφωνο" FontSize="27" Canvas.Left="8" Canvas.Top="165" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxPhone" Text="{Binding SelectedUser.Phone, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="240" Canvas.Top="165" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Label Content="Διεύθυνση" FontSize="27" Canvas.Left="8" Canvas.Top="225" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxAddress" Text="{Binding SelectedUser.Address, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="240" Canvas.Top="225" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Label Content="Ταυτότητα" FontSize="27" Canvas.Left="8" Canvas.Top="285" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <TextBox x:Name="txtBoxID" Text="{Binding SelectedUser.Id_num, Mode=TwoWay}" 
                 Background="#FFFFE1C0" FontSize="27" Canvas.Left="240" Canvas.Top="285" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" >
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>


        <CheckBox Content="Προβολή Αναφορών" FontSize="27" Canvas.Left="8" Canvas.Top="345"  IsChecked="{Binding SelectedUser.View_reports, Mode=TwoWay}" FontWeight="Medium"/>
        <CheckBox Content="Διαχειριστής" Canvas.Left="8" FontSize="27" Canvas.Top="405"  IsChecked="{Binding SelectedUser.Access_level, Mode=TwoWay}" FontWeight="Medium"/>
        <CheckBox Content="Επεξεργασία Προϊόντων (Read Only)" FontSize="27" Canvas.Left="8" Canvas.Top="466"  IsChecked="{Binding SelectedUser.Edit_prod, Mode=TwoWay}" FontWeight="Medium"/>
        <CheckBox Content="Πλήρης Επεξεργασία Προϊόντων" FontSize="27" Canvas.Left="8" Canvas.Top="525" IsChecked="{Binding SelectedUser.Edit_prod_full, Mode=TwoWay}" FontWeight="Medium" />
        <Label Content="Κωδικός Πρόσβασης" FontSize="27" Canvas.Left="8" Canvas.Top="585" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Medium"/>
        <PasswordBox x:Name="passwordBox" 
             FontSize="27" 
             Canvas.Left="320" Canvas.Top="585"
             Width="240" Background="#FFFFE1C0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <!-- Buttons -->
        <Button Height="60" Width="184"  Canvas.Left="396" Canvas.Top="665" Click="SaveButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
                <Image Source="/Resources/save.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Αποθήκευση" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>
        <Button Width="80" Height="60" Canvas.Left="598" Canvas.Top="665" Click="NewButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
                <Image Source="/Resources/add.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Νέος" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

        <Button Width="144" Height="60" Canvas.Left="698" Canvas.Top="665" Click="DeleteButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
                <Image Source="/Resources/delete.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Διαγραφή" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>


        <Button  Width="141" Height="60" Canvas.Left="863" Canvas.Top="665" Click="ExitButton_Click" FontSize="20" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
                <Image Source="/Resources/logout.png" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="Έξοδος" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" TextWrapping="Wrap" Height="68" FontSize="20"/>
            </Grid>
        </Button>

    </Canvas>
</Window>
